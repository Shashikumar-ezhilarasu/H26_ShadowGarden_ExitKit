# ExitKit Configuration

# Google GenAI / Gemini API Keys (one of these is required for Gemini backend)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Gemma 4 Model ID (required, e.g. gemma-4-it or gemma4:latest for ollama)
# Never hardcoded in the codebase
EXITKIT_GEMMA_MODEL=

# LLM Backend: "genai", "ollama", or "mock" (mock is strictly for unit testing)
EXITKIT_LLM_BACKEND=genai

# Optional Ollama Host URL (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional GitHub Token (for querying repository metadata / rate limit elevation)
GITHUB_TOKEN=
